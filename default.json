{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Asia/Tokyo",
  "assignees": ["tokku5552"],
  "automerge": true,
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "major": { "automerge": false, "dependencyDashboardApproval": true },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "prConcurrentLimit": 5 },
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on monday"] },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Python runtime (requires-python, .python-version, python Docker image) moves as one PR, only on approval",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "python runtime",
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
